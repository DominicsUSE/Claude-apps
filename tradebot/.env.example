# Copy this file to .env (or use the Connections tab in the dashboard, which writes .env for you).
# .env stays on your computer. Never share it, never commit it, never paste these into a chat.

# --- Solana wallet (Phantom or FOMO) ---
# The Solana private key of the wallet the bot trades (about 88 characters). Phantom: account menu >
# Manage Accounts > the account > Show Private Key. FOMO: Settings > Account > Export, Solana key.
# (Older versions called this FOMO_WALLET_PRIVATE_KEY; that name still works.)
SOLANA_WALLET_PRIVATE_KEY=
# Optional: free key from developers.jup.ag/portal (swaps work without one, just slower).
JUPITER_API_KEY=
# Optional: a private Solana RPC such as Helius (the public one is slow).
SOLANA_RPC_URL=

# --- Liquid (Hyperliquid) ---
# Your Liquid account address (0x...), and an API wallet key from app.hyperliquid.xyz > More > API.
# API wallets can trade but can never withdraw.
HL_ACCOUNT_ADDRESS=
HL_API_PRIVATE_KEY=

# --- TradingView alerts ---
# Any long random password. Put the same value in the "secret" field of your alert messages.
TV_WEBHOOK_SECRET=

# --- Optional data ---
QUIVER_API_TOKEN=
PERPLEXITY_API_KEY=
XAI_API_KEY=
