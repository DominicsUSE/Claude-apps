//@version=6
// Tradebot EMA trend: the same rules as the bot's "trend" strategy, for TradingView.
// 1. Add it to a chart (Pine Editor > paste > Add to chart). Check it in the Strategy Tester first: that is free practice.
// 2. Set "Webhook secret" in the settings to the same text as TV_WEBHOOK_SECRET in the bot.
// 3. Create an alert on this strategy. Message: {{strategy.order.alert_message}}
//    Notifications: Webhook URL = your tunnel address + /webhook (see the bot's Connections tab).
strategy("Tradebot EMA trend", overlay = true, initial_capital = 10000, default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.045, slippage = 2)

secret      = input.string("CHANGE_ME", "Webhook secret (TV_WEBHOOK_SECRET)")
sizeUsd     = input.float(25, "Bot position size (USD)", minval = 10)
fastLen     = input.int(20, "Fast EMA", minval = 1)
slowLen     = input.int(50, "Slow EMA", minval = 2)
useTrend    = input.bool(true, "Only trade with the 200 EMA trend")
trendLen    = input.int(200, "Trend EMA", minval = 2)
rsiLen      = input.int(14, "RSI length", minval = 2)
atrLen      = input.int(14, "ATR length", minval = 1)
atrStop     = input.float(2.0, "Stop distance (x ATR)", minval = 0.1)
rewardRisk  = input.float(2.5, "Target (x stop distance)", minval = 0.1)
allowShorts = input.bool(true, "Allow shorts")

fast  = ta.ema(close, fastLen)
slow  = ta.ema(close, slowLen)
trend = ta.ema(close, trendLen)
r     = ta.rsi(close, rsiLen)
a     = ta.atr(atrLen)
up    = ta.crossover(fast, slow)
down  = ta.crossunder(fast, slow)

longOk  = up and (not useTrend or close > trend) and r >= 50 and r <= 75
shortOk = down and allowShorts and (not useTrend or close < trend) and r >= 25 and r <= 50

sym = syminfo.prefix + ":" + syminfo.ticker
openMsg(string action, float stop, float target) =>
    '{"secret":"' + secret + '","symbol":"' + sym + '","action":"' + action + '","size_usd":' + str.tostring(sizeUsd) +
     ',"stop_price":' + str.tostring(stop, format.mintick) + ',"take_profit_price":' + str.tostring(target, format.mintick) +
     ',"comment":"Pine EMA trend"}'
closeMsg = '{"secret":"' + secret + '","symbol":"' + sym + '","action":"close","comment":"Pine EMA trend exit"}'

var float stopPx = na
var float targetPx = na

if longOk and strategy.position_size <= 0
    stopPx := close - a * atrStop
    targetPx := close + a * atrStop * rewardRisk
    strategy.entry("Long", strategy.long, alert_message = openMsg("buy", stopPx, targetPx))
else if shortOk and strategy.position_size >= 0
    stopPx := close + a * atrStop
    targetPx := close - a * atrStop * rewardRisk
    strategy.entry("Short", strategy.short, alert_message = openMsg("sell", stopPx, targetPx))

if strategy.position_size > 0 and down
    strategy.close("Long", alert_message = closeMsg)
if strategy.position_size < 0 and up
    strategy.close("Short", alert_message = closeMsg)

strategy.exit("Long stop/target", "Long", stop = stopPx, limit = targetPx, alert_message = closeMsg)
strategy.exit("Short stop/target", "Short", stop = stopPx, limit = targetPx, alert_message = closeMsg)

plot(fast, "Fast EMA", color.new(color.teal, 0))
plot(slow, "Slow EMA", color.new(color.orange, 0))
plot(useTrend ? trend : na, "Trend EMA", color.new(color.gray, 30), 2)
plot(strategy.position_size != 0 ? stopPx : na, "Stop", color.new(color.red, 0), 1, plot.style_linebr)
plot(strategy.position_size != 0 ? targetPx : na, "Target", color.new(color.green, 0), 1, plot.style_linebr)
