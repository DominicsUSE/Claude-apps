      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">HubConfig</string>
          <string name="Source"><![CDATA[-- World layout. +X is east, -Z is north. Spawn faces north toward the Forge.

local HubConfig = {}

HubConfig.Landmarks = {
	Spawn = Vector3.new(0, 0, 60), -- south
	Forge = Vector3.new(0, 0, 0), -- center
	Nursery = Vector3.new(62, 0, 22), -- east
	EggShop = Vector3.new(66, 0, -18), -- east
	QuestBoard = Vector3.new(-60, 0, -6), -- west
	UpgradeShop = Vector3.new(-62, 0, 28), -- west
	PortalPlaza = Vector3.new(0, 0, -82), -- north
}

-- Portal gates across the north plaza, west to east by unlock order.
HubConfig.Portals = {
	{ id = "SunkenGrove", x = -24, z = -86 },
	{ id = "FungalHollow", x = 0, z = -90 },
	{ id = "Cinderworks", x = 24, z = -86 },
}

-- The Sunken Grove sits away from the hub; portals connect the two.
HubConfig.GroveOrigin = Vector3.new(0, 0, 400)

HubConfig.Color = {
	Ground = Color3.fromRGB(46, 40, 34),
	GroundEdge = Color3.fromRGB(30, 27, 24),
	StoneDark = Color3.fromRGB(26, 26, 30),
	StoneBase = Color3.fromRGB(40, 40, 46),
	StoneRaised = Color3.fromRGB(70, 64, 58),
	Path = Color3.fromRGB(92, 80, 66),
	Brass = Color3.fromRGB(196, 150, 72),
	BrassBright = Color3.fromRGB(238, 190, 106),
	Amber = Color3.fromRGB(255, 176, 66),
	EmberRed = Color3.fromRGB(255, 92, 56),
	Parchment = Color3.fromRGB(238, 228, 208),
	Wood = Color3.fromRGB(110, 76, 48),
	WoodDark = Color3.fromRGB(68, 46, 30),
	Leaf = Color3.fromRGB(92, 150, 84),
	Grass = Color3.fromRGB(104, 168, 86),
	Moss = Color3.fromRGB(78, 128, 70),
	Rock = Color3.fromRGB(120, 118, 112),
}

return HubConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">QuestConfig</string>
          <string name="Source"><![CDATA[-- Starter quests. Each listens for one server event.
-- mode "max": progress is the highest value seen (used for levels), otherwise it adds up.

return {
	{
		id = "FirstShard",
		title = "Collect your first Ember Shard",
		hint = "Walk up to a glowing shard and press Collect.",
		event = "ShardCollected",
		target = 1,
		reward = { coins = 25, xp = 10 },
	},
	{
		id = "HatchForgekin",
		title = "Hatch a Forgekin",
		hint = "The Nursery is east of the Forge.",
		event = "ForgekinHatched",
		target = 1,
		reward = { coins = 50, gems = 5 },
	},
	{
		id = "BreakPod",
		title = "Break an Ember Crystal Pod",
		hint = "Hold Break on a large glowing crystal.",
		event = "PodBroken",
		target = 1,
		reward = { coins = 50, xp = 25 },
	},
	{
		id = "ForgeItem",
		title = "Forge your first item",
		hint = "The Forge Station opens soon.",
		event = "ItemForged",
		target = 1,
		reward = { coins = 100, xp = 50 },
	},
	{
		id = "UnlockFungal",
		title = "Unlock Fungal Hollow",
		hint = "Reach level 5.",
		event = "LevelReached",
		mode = "max",
		target = 5,
		reward = { gems = 10 },
	},
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">ResourceConfig</string>
          <string name="Source"><![CDATA[-- Collection tuning and placement. Edit numbers here; no other file needs to change.
-- Designers can also tag their own parts/models "EmberShard" or "CrystalPod" in Studio.

local ResourceConfig = {}

ResourceConfig.Shard = {
	amount = 1,
	xp = 2,
	respawnSeconds = 8,
	promptDistance = 9,
	hoverHeight = 1.8,
}

ResourceConfig.Pod = {
	holdSeconds = 1,
	promptDistance = 11,
	shardsMin = 3,
	shardsMax = 10,
	coinsMin = 4,
	coinsMax = 12,
	xpBonus = 10, -- on top of the per-shard xp
	respawnMin = 30,
	respawnMax = 60,
	rareCoreChance = 0.6, -- rare pods only
	rareCoresMin = 1,
	rareCoresMax = 2,
}

-- Seconds a player must wait between two collections (stops prompt spam).
ResourceConfig.ShardCooldown = 0.15
ResourceConfig.PodCooldown = 0.9

-- Hub placements (world positions on the ground; shards hover above them).
-- The first shard is a few steps in front of spawn: first pickup in under 10 seconds.
ResourceConfig.HubShards = {
	Vector3.new(0, 0, 51),
	Vector3.new(-3, 0, 45),
	Vector3.new(3, 0, 39),
	Vector3.new(-3, 0, 33),
	Vector3.new(14, 0, 24),
	Vector3.new(-14, 0, 24),
	Vector3.new(26, 0, 8),
	Vector3.new(-26, 0, 8),
	Vector3.new(40, 0, 14),
	Vector3.new(-40, 0, -2),
	Vector3.new(16, 0, -38),
	Vector3.new(-16, 0, -38),
}

ResourceConfig.HubPods = {
	{ position = Vector3.new(22, 0, 50) },
	{ position = Vector3.new(-34, 0, -40) },
}

-- Sunken Grove placements, relative to HubConfig.GroveOrigin.
ResourceConfig.GroveShards = {
	Vector3.new(0, 0, 62),
	Vector3.new(-4, 0, 54),
	Vector3.new(4, 0, 46),
	Vector3.new(-8, 0, 38),
	Vector3.new(8, 0, 30),
	Vector3.new(-14, 0, 22),
	Vector3.new(14, 0, 14),
	Vector3.new(0, 0, 8),
	Vector3.new(-24, 0, 0),
	Vector3.new(24, 0, 0),
	Vector3.new(-30, 0, -20),
	Vector3.new(30, 0, -20),
	Vector3.new(-10, 0, -32),
	Vector3.new(10, 0, -32),
	Vector3.new(0, 0, -46),
	Vector3.new(-44, 0, 34),
}

ResourceConfig.GrovePods = {
	{ position = Vector3.new(14, 0, 42) },
	{ position = Vector3.new(-18, 0, 30) },
	{ position = Vector3.new(28, 0, -8) },
	{ position = Vector3.new(-30, 0, -10) },
	-- Hidden behind the boulders in the north-west corner.
	{ position = Vector3.new(-66, 0, -66), rare = true },
}

return ResourceConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Theme</string>
          <string name="Source"><![CDATA[-- Theme: one palette for UI and world. Dark stone, brass, amber, parchment.

local Theme = {}

Theme.Color = {
	-- Stone panels
	StoneDeep = Color3.fromRGB(16, 15, 14),
	StoneBase = Color3.fromRGB(30, 28, 26),
	StoneRaised = Color3.fromRGB(46, 42, 38),

	-- Brass borders and amber highlights
	Brass = Color3.fromRGB(196, 150, 72),
	BrassBright = Color3.fromRGB(238, 190, 106),
	BrassDim = Color3.fromRGB(120, 92, 50),
	Amber = Color3.fromRGB(255, 176, 66),
	Ember = Color3.fromRGB(255, 112, 52),

	-- Text
	Parchment = Color3.fromRGB(238, 228, 208),
	ParchmentDim = Color3.fromRGB(186, 174, 152),
	ParchmentMute = Color3.fromRGB(128, 120, 106),

	-- Currencies and resources
	Coin = Color3.fromRGB(240, 196, 92),
	Gem = Color3.fromRGB(222, 84, 108),
	Shard = Color3.fromRGB(255, 150, 48),
	Core = Color3.fromRGB(178, 120, 255),

	-- Feedback
	Success = Color3.fromRGB(150, 204, 116),
	Error = Color3.fromRGB(226, 96, 80),
}

Theme.Font = {
	Display = Enum.Font.GrenzeGotisch, -- big brand text only
	Title = Enum.Font.Merriweather,
	Body = Enum.Font.Nunito,
	Number = Enum.Font.Oswald,
}

Theme.Radius = {
	Small = UDim.new(0, 6),
	Medium = UDim.new(0, 10),
	Large = UDim.new(0, 14),
}

-- Keys the Forgekin Milestone 1 UILibrary and panels read, so kept panels
-- (Settings, for example) still work next to the new HUD.
for name, color in pairs({
	StoneLight = Color3.fromRGB(58, 52, 46),
	StoneHairline = Color3.fromRGB(74, 66, 58),
	BrassDeep = Color3.fromRGB(82, 60, 32),
	AmberSoft = Color3.fromRGB(216, 158, 80),
	AmberGlow = Color3.fromRGB(255, 208, 128),
	Danger = Color3.fromRGB(200, 86, 62),
	DangerBright = Color3.fromRGB(240, 118, 88),
	Frost = Color3.fromRGB(126, 200, 220),
	Gold = Color3.fromRGB(230, 195, 118),
	Shadow = Color3.fromRGB(0, 0, 0),
	Glow = Color3.fromRGB(255, 190, 120),
}) do
	Theme.Color[name] = color
end
Theme.Font.Medium = Enum.Font.Nunito
Theme.Font.Mono = Enum.Font.Code
Theme.Font.Serif = Enum.Font.Merriweather
Theme.Radius.XL = UDim.new(0, 20)
Theme.Radius.Pill = UDim.new(1, 0)
Theme.TextSize = { Tiny = 10, Small = 11, Body = 13, Label = 14, Subhead = 16, Header = 20, Title = 26, Hero = 34 }
Theme.Spacing = { XS = 4, S = 8, M = 12, L = 16, XL = 24, XXL = 32 }
Theme.Stroke = { Hairline = 1, Default = 1.5, Bold = 2 }
Theme.Anim = {
	Fast = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	Default = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
	Slow = TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
	Spring = TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	Snap = TweenInfo.new(0.1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
}

Theme.Game = {
	Title = "EMBERHATCH",
	Subtitle = "HATCH · FORGE · EXPLORE",
}

return Theme
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">ZoneConfig</string>
          <string name="Source"><![CDATA[-- Areas. Only three worlds for now, plus the hub.
-- Fungal Hollow and Cinderworks have portals but are built in Milestone E.

local ZoneConfig = {}

ZoneConfig.Hub = "EmberHollow"

ZoneConfig.Zones = {
	EmberHollow = {
		displayName = "Ember Hollow",
		subtitle = "Forge town",
		unlockLevel = 1,
	},
	SunkenGrove = {
		displayName = "Sunken Grove",
		subtitle = "Starter area",
		tier = 1,
		unlockLevel = 1,
		portalColor = Color3.fromRGB(126, 196, 120),
		portalGlow = Color3.fromRGB(186, 244, 168),
	},
	FungalHollow = {
		displayName = "Fungal Hollow",
		subtitle = "Mushroom caves",
		tier = 2,
		unlockLevel = 5,
		portalColor = Color3.fromRGB(96, 206, 190),
		portalGlow = Color3.fromRGB(196, 150, 255),
	},
	Cinderworks = {
		displayName = "Cinderworks",
		subtitle = "Lava foundry",
		tier = 3,
		unlockLevel = 10,
		portalColor = Color3.fromRGB(255, 112, 60),
		portalGlow = Color3.fromRGB(255, 168, 96),
	},
}

return ZoneConfig
]]></string>
        </Properties>
