{
  "name": "snug",
  "version": "0.9.6",
  "private": true,
  "type": "module",
  "description": "A calm place for your people: houses, rooms, threads and voice.",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/logic*.test.js tests/server*.test.js registry/test/*.test.js",
    "test:registry": "node --disable-warning=ExperimentalWarning --test registry/test/*.test.js",
    "registry": "node --disable-warning=ExperimentalWarning registry/dev.js",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/e2e*.test.js",
    "test:e2e:calls": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/e2e-calls.test.js",
    "test:e2e:video": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/e2e-video.test.js",
    "test:e2e:emoji": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/e2e-emoji.test.js",
    "test:e2e:notify": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/e2e-notify.test.js",
    "test:e2e:messages": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/e2e-messages.test.js",
    "test:e2e:safety": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/e2e-safety.test.js",
    "test:e2e:messaging": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/e2e-messaging.test.js",
    "test:e2e:places": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/e2e-places.test.js",
    "test:e2e:voice-options": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/e2e-voice-options.test.js",
    "test:e2e:account": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/e2e-account.test.js",
    "test:e2e:community": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/e2e-community.test.js",
    "test:e2e:integration": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/e2e-integration.test.js"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
