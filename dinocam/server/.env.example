# Copy this file to .env (or set these as real environment variables on whatever host
# you deploy to — Render, Railway, Fly.io, a VPS, etc.) and fill in your own values.
# NEVER commit a real .env file or paste your real API key into the DinoCamSecurity
# app itself, a .cmd file, or any client-side code — it belongs only here, server-side.

# Which recognition engine to use. "claude-vision" (default) asks Claude to read the
# plate directly from the image — needs ANTHROPIC_API_KEY. "plate-recognizer" uses the
# dedicated ANPR service platerecognizer.com — needs PLATE_RECOGNIZER_API_KEY. Only the
# key for whichever engine you pick needs to be set.
RECOGNITION_PROVIDER=claude-vision

# Required if RECOGNITION_PROVIDER=claude-vision.
# Get one at https://console.anthropic.com/ -> Settings -> API Keys.
ANTHROPIC_API_KEY=

# Optional, only for RECOGNITION_PROVIDER=claude-vision: which Claude model to use.
# Defaults to claude-opus-5-5 if unset.
CLAUDE_VISION_MODEL=claude-opus-5-5

# Required if RECOGNITION_PROVIDER=plate-recognizer.
# Get one at https://platerecognizer.com/ -> Dashboard -> API Key.
PLATE_RECOGNIZER_API_KEY=

# Optional: restrict which origins may call this backend. Leave blank to allow any
# origin (fine for local testing; for a real deployment, set this to the exact origin
# DinoCamSecurity is served from, or "*" if you serve it as a local file:// app where
# the browser sends no Origin header).
ALLOWED_ORIGIN=

# Port to listen on (most hosts set this for you automatically).
PORT=8787
