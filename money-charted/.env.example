# Copy this file to .env and fill in what you use. Never share .env or show it on screen.

# Required for writing scripts: https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Optional: AI voiceover. Leave empty to use your own recordings (voice/<id>.wav)
# or to render silent previews with captions only. Commercial use needs a paid ElevenLabs plan.
ELEVENLABS_API_KEY=
# Optional: a voice from your ElevenLabs voice library (default is a stock narrator)
ELEVENLABS_VOICE_ID=

# Optional: path to a Chrome/Chromium headless shell if Remotion cannot download its own
REMOTION_BROWSER=
